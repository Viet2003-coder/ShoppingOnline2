<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.product.HomeFragment"
    android:padding="8dp">

    <!-- Search bar -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Tìm kiếm sản phẩm"
        android:iconifiedByDefault="false"/>

    <!-- Sản phẩm mới nhất (Horizontal RecyclerView) -->
    <TextView
        android:id="@+id/tvNewArrivals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sản phẩm mới nhất"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textSize="16sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNewArrivals"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:scrollbars="horizontal"/>

    <!-- Danh sách sản phẩm chính (Vertical RecyclerView) -->
    <TextView
        android:id="@+id/tvAllProducts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tất cả sản phẩm"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textSize="16sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
